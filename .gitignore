# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Env / secrets
.env
.env.*
!.env.example

# Local databases / runtime artifacts (defensive — actual data lives in XDG paths)
*.sqlite
*.sqlite3
*.db

# Claude Code scheduled-tasks lock (per-process runtime state: pid/session/acquiredAt)
.claude/scheduled_tasks.lock

# Plugin distribution binaries (populated on the dist branch / by install gate
# at runtime). PRD §5.1: main carries src; dist carries built binaries.
plugin/bin/*
!plugin/bin/.gitkeep
plugin/daemon/bin/*
!plugin/daemon/bin/.gitkeep

# Local install marker written by ensureInstalled (LM-8: lives under pluginRoot)
plugin/.sdi-version

# sdi-web build artifacts. Source lives in plugin/web/ (snapshot-imported from
# the now-archived sdi-web repo); the built SPA is served by sdid via tower-http
# ServeDir under plugin/web/dist/. Generated on demand by `pnpm --dir plugin/web
# build` (release.yml + first-run install prompt).
plugin/web/node_modules/
plugin/web/dist/
plugin/web/*.tsbuildinfo
plugin/web/.vite/
